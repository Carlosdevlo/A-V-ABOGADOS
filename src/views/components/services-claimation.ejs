<section class="services-claimation section" id="servicios">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Nuestros servicios</span>
      </div>
      <h2 class="section__title">¿Qué podemos reclamar por usted?</h2>
      <p class="section__subtitle">
        Acompañamiento jurídico integral para víctimas de accidentes de tránsito y familias afectadas por homicidios culposos.
      </p>
    </div>

    <div class="services-grid" data-aos="fade-up" data-aos-delay="100">
      <% services.forEach((service, index) => { %>
        <a href="#contacto" class="service-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <div class="service-card__img-wrap">
            <img src="<%= service.image %>" alt="<%= service.title %> - A&V Abogados" class="service-card__img" loading="lazy" width="400" height="300">
            <div class="service-card__overlay"></div>
          </div>
          <div class="service-card__body">
            <div class="service-card__icon">
              <i data-lucide="<%= service.icon %>" aria-hidden="true"></i>
            </div>
            <h3 class="service-card__title"><%= service.title %></h3>
            <p class="service-card__text"><%= service.description %></p>
            <span class="service-card__cta">Conocer más <i data-lucide="arrow-right" aria-hidden="true"></i></span>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="section__cta" data-aos="fade-up" data-aos-delay="600">
      <a href="javascript:void(0)" class="btn btn--primary btn--lg" data-modal-trigger>Solicitar asesoría sin costo</a>
    </div>
  </div>
</section>