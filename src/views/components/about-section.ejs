<section class="about section" id="quienes-somos">
  <div class="container">
    <div class="about__layout" data-aos="fade-up">
      <div class="about__media" data-aos="fade-right">
        <div class="about__img-wrap">
          <img src="<%= aboutContent.image %>" alt="Abogados profesionales en conversación - A&V Abogados" class="about__img" loading="lazy" width="600" height="500">
          <div class="about__img-overlay"></div>
        </div>
      </div>

      <div class="about__content" data-aos="fade-left">
        <div class="section__badge">
          <span class="section__badge-dot"></span>
          <span class="section__badge-text"><%= aboutContent.badge %></span>
        </div>
        <h2 class="section__title"><%= aboutContent.title %></h2>
        <p class="section__subtitle">
          <%= aboutContent.subtitle %>
        </p>
        <div class="about__description">
          <p><%= aboutContent.description %></p>
        </div>

        <div class="about__values" data-aos="fade-up" data-aos-delay="200">
          <% aboutContent.values.forEach((value, index) => { %>
            <div class="about__value" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
              <div class="about__value-icon">
                <i data-lucide="<%= value.icon %>" aria-hidden="true"></i>
              </div>
              <h3 class="about__value-title"><%= value.title %></h3>
              <p class="about__value-text"><%= value.description %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>