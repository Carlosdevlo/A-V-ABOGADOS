<section class="companies section" id="aseguradoras" aria-labelledby="companies-title">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Nuestra experiencia</span>
      </div>
      <h2 class="section__title" id="companies-title">Experiencia que respalda nuestro trabajo</h2>
      <p class="section__subtitle">
        Hemos gestionado reclamaciones y negociado directamente con las principales compañías de seguros del país.
      </p>
    </div>

    <ul class="companies__grid" role="list">
      <% companies.forEach(function(company, index) { %>
        <li class="companies__card" data-aos="fade-up" data-aos-delay="<%= index * 40 %>">
          <span class="companies__logo-wrap">
            <img src="<%= company.logo %>" alt="<%= company.name %>" class="companies__logo" loading="lazy" decoding="async">
          </span>
          <span class="companies__name"><%= company.name %></span>
        </li>
      <% }) %>
    </ul>

    <p class="companies__note">Entre otras...</p>
  </div>
</section>