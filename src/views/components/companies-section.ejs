<section class="companies section" id="aseguradoras">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Nuestra experiencia</span>
      </div>
      <h2 class="section__title">Experiencia frente a compañías de seguros</h2>
      <p class="section__subtitle">
        Contamos con experiencia frente a diversas compañías de seguros en nuestras reclamaciones.
      </p>
    </div>

    <div class="companies__list" data-aos="fade-up" data-aos-delay="100">
      <ul class="companies__ul">
        <% companies.forEach((company, index) => { %>
          <li class="companies__item" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
            <%= company.name %>
          </li>
        <% }) %>
      </ul>
      <p class="companies__note">Entre otras...</p>
    </div>
  </div>
</section>