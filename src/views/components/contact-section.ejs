<section class="contact-section section" id="contacto">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info" data-aos="fade-right">
        <div class="section__badge">
          <span class="section__badge-dot"></span>
          <span class="section__badge-text">Contacto</span>
        </div>
        <h2 class="contact__title">Cuéntenos qué ocurrió</h2>
        <p class="contact__subtitle">
          Un integrante de nuestro equipo puede revisar inicialmente su situación.
        </p>
        <div class="contact__details">
          <div class="contact__detail">
            <i data-lucide="map-pin" class="contact__detail-icon" aria-hidden="true"></i>
            <address>
              Av. Calle 26 # 69-76, Edificio Elemento, Torre 3 (Tierra), Oficina 1501, Bogotá D.C.
            </address>
          </div>
          <div class="contact__detail">
            <i data-lucide="phone" class="contact__detail-icon" aria-hidden="true"></i>
            <p>(601) 484 9186</p>
          </div>
          <div class="contact__detail">
            <i data-lucide="smartphone" class="contact__detail-icon" aria-hidden="true"></i>
            <p>300 881 1886</p>
          </div>
          <div class="contact__detail">
            <i data-lucide="mail" class="contact__detail-icon" aria-hidden="true"></i>
            <p>contacto@abogadosav.com</p>
          </div>
          <div class="contact__detail">
            <i data-lucide="globe" class="contact__detail-icon" aria-hidden="true"></i>
            <p>www.abogadosav.com</p>
          </div>
        </div>
        <div class="contact__hours">
          <i data-lucide="clock" class="contact__detail-icon" aria-hidden="true"></i>
          <span>Horario: Lunes a viernes, 8:00 a. m. a 6:00 p. m.</span>
        </div>
        <div class="contact__cta">
          <a href="javascript:void(0)" class="btn btn--primary btn--lg" data-modal-trigger>
            <i data-lucide="edit-3" class="btn__icon" aria-hidden="true"></i> Evaluar mi caso
          </a>
          <a href="<%= whatsappLink %>" class="btn btn--whatsapp btn--lg" target="_blank" rel="noopener noreferrer" aria-label="Hablar por WhatsApp">
            <i data-lucide="whatsapp" class="btn__icon" aria-hidden="true"></i> Hablar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
