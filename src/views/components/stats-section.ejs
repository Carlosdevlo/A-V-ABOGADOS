<section class="stats section" id="experiencia" aria-labelledby="stats-title">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="stats__mark">
        <img src="/images/brand/av-logo.png" alt="" class="stats__mark-img" loading="lazy" width="150" height="50">
      </div>
      <h2 class="section__title" id="stats-title">Nuestra trayectoria en cifras</h2>
      <p class="section__subtitle">
        Un equipo que trabaja sobre resultados y acompaña a sus clientes hasta el final del proceso.
      </p>
    </div>

    <ul class="stats__grid" role="list">
      <% stats.forEach(function(stat, index) { %>
        <li class="stats__card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <span class="stats__icon" aria-hidden="true">
            <i data-lucide="<%= stat.icon %>"></i>
          </span>
          <p class="stats__value">
            <span class="stats__number"><%= stat.value %></span><% if (stat.suffix) { %><span class="stats__suffix"><%= stat.suffix %></span><% } %>
          </p>
          <p class="stats__label"><%= stat.label %></p>
        </li>
      <% }) %>
    </ul>
  </div>
</section>