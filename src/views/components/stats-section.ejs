<section class="stats section section--stats-premium" id="estadisticas">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Nuestra experiencia</span>
      </div>
      <h2 class="section__title">Estadísticas que hablan por sí mismas</h2>
