<section class="hero" id="inicio">
  <div class="hero--split container">
    <div class="hero__content" data-aos="fade-up">
      <div class="hero__badge" data-aos="fade-down">
        <span class="hero__badge-text">A&V ABOGADOS</span>
      </div>

      <h1 class="hero__title" data-aos="fade-up" data-aos-delay="100">
        ¿Fue víctima de un accidente de tránsito?
      </h1>

      <p class="hero__subtitle" data-aos="fade-up" data-aos-delay="200">
        Defendemos sus derechos y le acompañamos durante todo el proceso.
      </p>

      <p class="hero__text" data-aos="fade-up" data-aos-delay="300">
        Abogados especializados en seguros y responsabilidad civil. Lo acompañamos frente a
        aseguradoras y durante todo el proceso jurídico.
      </p>

      <div class="hero__cta" data-aos="fade-up" data-aos-delay="400">
        <a href="#contacto" class="btn btn--primary btn--lg">Evaluar mi caso gratis</a>
        <a href="<%= whatsappLink %>" class="btn btn--outline btn--lg" target="_blank" rel="noopener noreferrer">
          <i data-lucide="whatsapp" class="btn__icon" aria-hidden="true"></i> Hablar por WhatsApp
        </a>
      </div>

      <div class="hero__trust" data-aos="fade-up" data-aos-delay="500">
        <div class="hero__trust-item">
          <i data-lucide="check" class="hero__trust-icon" aria-hidden="true"></i>
          <span>Asesoría inicial sin costo</span>
        </div>
        <div class="hero__trust-item">
          <i data-lucide="target" class="hero__trust-icon" aria-hidden="true"></i>
          <span>Trabajamos sobre resultados</span>
        </div>
        <div class="hero__trust-item">
          <i data-lucide="shield-check" class="hero__trust-icon" aria-hidden="true"></i>
          <span>Acompañamiento jurídico integral</span>
        </div>
      </div>
    </div>

    <div class="hero__visual" data-aos="fade-left">
      <div class="hero__visual-placeholder">
        <div class="hero__visual-icon">
          <i data-lucide="gavel" class="hero__visual-icon-img" aria-hidden="true"></i>
        </div>
        <span class="hero__visual-text">Acompañamiento integral</span>
      </div>
    </div>
  </div>
</section>
