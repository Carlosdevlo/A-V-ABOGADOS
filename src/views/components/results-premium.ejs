<section class="results-premium section" id="sobre-resultados">
  <div class="container">
    <div class="results-premium__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Sobre resultados</span>
      </div>
      <h2 class="results-premium__title">Transparencia desde el primer momento</h2>
      <p class="results-premium__subtitle">
        Entendemos que después de un accidente lo más importante es saber qué esperar.
      </p>
    </div>

    <div class="premium-percentage" data-aos="fade-up" data-aos-delay="100">
      <div class="premium-percentage__display">
        <span class="premium-percentage__number">30%</span>
      </div>
      <div class="premium-percentage__info">
        <p class="premium-percentage__caption">Sobre el monto total de la indemnización</p>
        <p class="premium-percentage__text">Solo generamos honorarios si ganamos el caso.</p>
      </div>
    </div>

    <div class="results-premium__points">
      <div class="value-prop boxed" data-aos="fade-up" data-aos-delay="200">
        <div class="value-prop__icon">
          <i data-lucide="shield-check" aria-hidden="true"></i>
        </div>
        <div class="value-prop__content">
          <h3 class="value-prop__title">Asesoría sin costo</h3>
          <p class="value-prop__text">Usted no paga por la valoración inicial de su caso.</p>
        </div>
        <a href="#contacto" class="btn btn--outline btn--lg">Evaluar mi caso</a>
      </div>

      <div class="value-prop note" data-aos="fade-up" data-aos-delay="300">
        <div class="value-prop__icon">
          <i data-lucide="gavel" aria-hidden="true"></i>
        </div>
        <div class="value-prop__content">
          <h3 class="value-prop__title note__title">ACOMPAÑAMIENTO PENAL</h3>
          <p class="value-prop__text note__text">
            Asistencia sin costo frente al proceso penal en la Fiscalía.
          </p>
        </div>
      </div>
    </div>

    <div class="results-premium__cta" data-aos="fade-up" data-aos-delay="400">
      <a href="#contacto" class="btn btn--primary btn--xl">Hablar con un abogado</a>
    </div>
  </div>
</section>
