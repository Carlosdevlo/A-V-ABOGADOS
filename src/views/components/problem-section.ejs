<section class="problem-section section" id="problema">
  <div class="container">
    <div class="section__header" data-aos="fade-up">
      <div class="section__badge">
        <span class="section__badge-dot"></span>
        <span class="section__badge-text">Guía importante</span>
      </div>
      <h2 class="section__title">¿Qué hacer después de un accidente?</h2>
      <p class="section__subtitle">
        Guía rápida para proteger sus derechos desde el primer momento.
      </p>
    </div>

    <div class="problem-grid" data-aos="fade-up" data-aos-delay="100">
      <% accidentSteps.forEach((step, index) => { %>
        <div class="problem-step" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <div class="problem-step__marker">
            <span class="problem-step__number"><%= step.number %></span>
          </div>
          <div class="problem-step__content">
            <h3 class="problem-step__title"><%= step.title %></h3>
            <p class="problem-step__text"><%= step.description %></p>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="problem-grid__cta" data-aos="fade-up" data-aos-delay="700">
      <a href="javascript:void(0)" class="btn btn--primary btn--lg" data-modal-trigger>Evaluar mi caso sin costo</a>
    </div>
  </div>
</section>