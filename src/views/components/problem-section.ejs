<section class="problem section" id="problema">
  <div class="container">
    <div class="problem__layout">
      <div class="problem__text" data-aos="fade-right">
        <div class="section__badge">
          <span class="section__badge-dot"></span>
          <span class="section__badge-text">Situación de riesgo</span>
        </div>
        <h2 class="problem__title">¿Fue víctima de un accidente de tránsito?</h2>
        <p class="problem__subtitle">
          Después de un siniestro, cada decisión cuenta. Usted necesita un abogado
          que entienda su situación y actúe de inmediato para proteger sus derechos.
        </p>
        <div class="problem__cta">
          <a href="#contacto" class="btn btn--primary btn--lg">Evaluar mi caso sin costo</a>
          <a href="<%= whatsappLink %>" class="btn btn--whatsapp btn--lg" target="_blank" rel="noopener noreferrer" aria-label="Hablar por WhatsApp">
            <i data-lucide="whatsapp" class="btn__icon" aria-hidden="true"></i> Hablar por WhatsApp
          </a>
        </div>
      </div>
      <div class="problem__visual" data-aos="fade-left">
        <img src="/images/sections/problema-legal.jpg" alt="Abogado revisando documentos jurídicos - A&V Abogados" class="problem__img" loading="lazy" width="600" height="400">
      </div>
    </div>
  </div>
</section>
