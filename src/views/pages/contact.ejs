<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contacto | A&V Abogados</title>
  <meta name="description" content="Comuníquese con A&V Abogados para obtener asesoría jurídica sin costo sobre su accidente de tránsito en Colombia.">
  <meta name="theme-color" content="#008037">
  <meta name="color-scheme" content="light">

  <meta property="og:title" content="Contacto | A&V Abogados">
  <meta property="og:description" content="Comuníquese con A&V Abogados para obtener asesoría jurídica sin costo sobre su accidente de tránsito en Colombia.">
  <meta property="og:image" content="/images/hero/og-image-contact.webp">
  <meta property="og:url" content="https://www.abogadosav.com/contacto">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_CO">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="canonical" href="https://www.abogadosav.com/contacto">
  <link rel="icon" href="/images/logo/favicon.avif" type="image/avif" sizes="32x32">

<link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/hero.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/responsive.css">

  <script defer src="https://unpkg.com/lucide@0.450.0/dist/lucide.min.js"></script>
</head>
<body class="contact">
  <%- include('partials/whatsapp-button') %>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-hero section" id="contacto">
      <div class="container">
        <div class="page-hero__content" data-aos="fade-up">
          <h1 class="page-hero__title">Contacto</h1>
          <p class="page-hero__subtitle">
            Déjenos su información y un abogado se pondrá en contacto con usted.
          </p>
        </div>
      </div>
    </section>

    <%- include('components/contact-section') %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/navbar.js" defer></script>
  <script src="/js/animations.js" defer></script>
  <script src="/js/contact.js" defer></script>
  <script src="/js/main.js" defer></script>
  <script>
    window.__WHATSAPP_LINK__ = "<%= whatsappLink %>";
  </script>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
